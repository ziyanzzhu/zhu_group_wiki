	url = {https://www.nature.com/articles/s41578-021-00284-1},
	doi = {10.1038/s41578-021-00284-1},
	abstract = {Moiré systems formed by 2D atomic layers have widely tunable electrical and optical properties and host exotic, strongly correlated and topological phenomena, including superconductivity, correlated insulator states and orbital magnetism. In this Viewpoint, researchers studying different aspects of moiré materials discuss the most exciting directions in this rapidly expanding field.},
